# ====================== Statio Nexus - .env.example ======================
# Copy this file to .env for development or .env.production for production

NODE_ENV=development
PORT=5000

# ====================== DATABASE ======================
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.yhq2vxz.mongodb.net/statio-nexus?retryWrites=true&w=majority

# ====================== JWT ======================
JWT_SECRET=your-super-long-random-jwt-secret-key-here-minimum-64-characters
JWT_EXPIRES_IN=7d

# ====================== SEEDING ======================
# Set to true only in development
SEED_DEMO_DATA=true

# ====================== CORS ======================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5500

# ====================== REDIS ======================
REDIS_URL=redis://:your-redis-password@localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=your-redis-password

# ====================== EMAIL ======================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_SECURE=false

EMAIL_FROM=noreply@statio-nexus.com
EMAIL_FROM_NAME=Statio Nexus Support
SUPPORT_EMAIL=support@statio-nexus.com
FRONTEND_URL=http://localhost:5173

# ====================== WEB PUSH ======================
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_EMAIL=admin@statio-nexus.com

# ====================== STRIPE (Optional) ======================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ====================== SECURITY ======================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====================== LOGGING ======================
LOG_LEVEL=info