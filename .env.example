# Root environment template
# Copy this file to .env and update values.

# Backend
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars

# Database
MONGO_URI=mongodb://127.0.0.1:27017/statio_nexus

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Payments (optional)
STRIPE_SECRET_KEY=

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Error tracking (optional)
SENTRY_DSN=
