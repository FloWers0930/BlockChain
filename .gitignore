# ====================== Statio Nexus .gitignore ======================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables (Never commit secrets!)
backend/.env
backend/.env.production
backend/.env.local
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production

# Build outputs
backend/dist/
frontend/dist/
frontend/build/

# Logs
backend/logs/
*.log

# Docker
.docker/
.dockerignore

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
.tmp/
temp/
.cache/

# Redis data (local only)
redis-data/

# Production files
*.production

# Optional: Coverage reports
coverage/
.nyc_output/

# PM2
.pm2/